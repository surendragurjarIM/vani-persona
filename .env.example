# Sarvam speech APIs (STT/TTS/chat) - used by the offline pipeline and the local voice lab
SARVAM_API_KEY=

# Sarvam Voice Agents REST (dashboard -> Settings -> API Key). Different from SARVAM_API_KEY.
SARVAM_VA_API_KEY=
SARVAM_ORG_ID=01a110de-7159-7b40-a3eb-00943f7aa055
SARVAM_WORKSPACE_ID=01a110de-715e-7fa2-9971-d8ed6286574c

# Telephony, needed only to place calls (dashboard -> Deploy -> Phone Numbers)
SARVAM_CONNECTION_ID=
SARVAM_AGENT_NUMBER=

# Where Sarvam can reach this service (https). Leave empty when running only locally.
PUBLIC_BASE_URL=
# Long random strings; required as soon as PUBLIC_BASE_URL is set
WEBHOOK_TOKEN=
ONSTART_TOKEN=
